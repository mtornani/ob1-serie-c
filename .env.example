# OB1 Serie C - Environment Variables
# Copia in .env e compila con i valori reali. Non committare .env.

# === SCRAPING / AI ===

# Tavily API key (scraping primario — Ouroboros pipeline)
TAVILY_API_KEY=your_tavily_key_here

# Serper.dev API key — OPZIONALE, non più obbligatoria per la ricerca.
# Senza, la catena free è: cache -> DuckDuckGo -> SearXNG -> Tavily.
SERPER_API_KEY=
# OB1_SEARCH_MODE=serper   # forza Serper per primo (comportamento legacy)
# SEARXNG_INSTANCES=https://searx.be,https://searxng.site
# OB1_SEARCH_CACHE=1       # 0 = disabilita la cache ricerche (debug)

# Google Gemini API key — OPZIONALE.
# Serve solo con OB1_LLM_MODE=gemini_first o per il grounding. L'enrichment
# free (DDG + Groq) funziona senza. Se la usi: billing Google OFF.
GEMINI_API_KEY=
# NB: gemini-2.0-flash è deprecato (404). Default corretto: 2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# === LLM: catena free ===
# free_first (default) = free poi Gemini · free_only = Gemini mai
# gemini_first = grounding Gemini per primo (unica voce fatturabile)
OB1_LLM_MODE=free_first

# === LLM GATEWAY (ARCH-001) ===
# Routing multi-provider free-tier: vedi config/llm_providers.yaml e
# .dev/ARCH-001_production_llm.md. Nessuna è obbligatoria — più ne configuri,
# più capacità gratuita aggregata ha la pipeline.
# Una env var può contenere più chiavi separate da virgola (sharding budget).

# Cerebras — ~1M token/giorno, il cavallo da soma dell'extract
CEREBRAS_API_KEY=
# Groq — 1.000 richieste/giorno
GROQ_API_KEY=
# Mistral — ~1B token/mese (attenzione: free tier usa i dati per training)
MISTRAL_API_KEY=
# OpenRouter — modelli frontier gratis (DeepSeek V3.2, Qwen3-235B)
OPENROUTER_API_KEY=
# NVIDIA NIM — DeepSeek V3.1 gratis
NVIDIA_API_KEY=
# Endpoint OpenAI-compatible self-hosted (COMPARE / LM Studio / Ollama)
# COMPARE_BASE_URL=http://localhost:20128/v1
# COMPARE_MODEL=local-model

# Switch gateway (default già corretti, elencati per riferimento)
# OB1_LLM_GATEWAY=1          # 0 = torna al fallback legacy Groq/OpenRouter
# OB1_LLM_CACHE=1            # 0 = disabilita la cache risposte
# OB1_LLM_ALLOW_PAID=0       # 1 = abilita rotte a pagamento (kill switch costi)
# OB1_LLM_COMMERCIAL_ONLY=1  # 0 = ammette modelli non commerciali
# OB1_LLM_ALLOW_TRAINING=1   # 0 = esclude provider che si addestrano sui prompt

# Budget discovery Gemini per run (lascia RPD all'enrich)
# GEMINI_DISCOVERY_BUDGET=4
# MAX_ENRICH_BATCHES=4

# === TELEGRAM ===

# Bot token (unico per tutti i canali)
# Crea il bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_token_here

# Chat ID privato Mirko — notifiche pipeline success
# Ottieni con: https://t.me/userinfobot
TELEGRAM_CHAT_ID=1465485090

# Canale pubblico @ob1scout — alert HOT pubblici
TELEGRAM_PUBLIC_CHANNEL_ID=@ob1scout

# Canale admin privato — alert errori pipeline (NUOVO — Fix 2/3)
# Crea un gruppo privato o usa il tuo chat ID personale
TELEGRAM_OFFICE_CHAT_ID=your_office_chat_id_here

# === CLOUD DEPLOY (GitHub Actions) ===
# Settings → Secrets → Actions → New repository secret
#
# Secrets da configurare:
#   TAVILY_API_KEY           ← scraping primario
#   SERPER_API_KEY           ← fallback scraping
#   GEMINI_API_KEY           ← AI enrichment
#   TELEGRAM_BOT_TOKEN       ← bot token unico
#   TELEGRAM_CHAT_ID         ← chat ID notifiche success
#   TELEGRAM_PUBLIC_CHANNEL_ID ← canale @ob1scout
#   TELEGRAM_OFFICE_CHAT_ID  ← ⚠️ NUOVO: alert errori pipeline
